# Copy this file to `.env` and fill in your values.
# NEVER commit a real .env file to GitHub — it contains your secret key.

# Your API key (OpenAI, or a free Google Gemini key — see README).
LLM_API_KEY=

# Which API server to talk to. Default is OpenAI:
LLM_BASE_URL=https://api.openai.com/v1

# Which model to use.
LLM_MODEL=gpt-4o-mini
